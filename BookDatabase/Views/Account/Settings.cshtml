@model UserSettingsDto

@{
    ViewData["Title"] = "Settings";
}

<div class="about-container" style="max-width: 800px; margin: 2rem auto; padding: 1rem;">
    <h1 class="text-3xl font-bold mb-4">Settings</h1>

    <h2 class="text-xl font-semibold mt-6 mb-2">General</h2>
    <form id="newUsernameForm" method="post" asp-controller="Account" asp-action="changeUsername">
        @Html.AntiForgeryToken()
        <input type="hidden" id="newUserInput" name="newUsername" />
        <button type="button" id="changeUsername">Change Username</button>
    </form>
    <form method="post">
    <ul class="list-disc list-inside space-y-1 mb-4">
        
        <li>
            <h3 class="mb-2">Keyboard Shortcuts</h3>

            
            <ul>
                <li><h5>Usable Everywhere</h5></li>
                <ul>
                    <li>
                        <div class="row">
                            <label class="col-sm-4 col-form-label">Go to Home page: </label>
                            <div class="col-sm-8">
                                <input id="homeShortcutInput" asp-for="homeShortcut">
                                <span asp-validation-for="homeShortcut" class="text-danger"></span>
                            </div>
                        </div>
                    </li>
                    <li>
                        <div class="row">
                            <label class="col-sm-4 col-form-label">Go to Books page: </label>
                            <div class="col-sm-8">
                                <input id="booksShortcutInput" asp-for="booksShortcut">
                                <span asp-validation-for="booksShortcut" class="text-danger"></span>
                            </div>
                        </div>
                    </li>
                    <li>
                        <div class="row">
                            <label class="col-sm-4 col-form-label">Go to Privacy page: </label>
                            <div class="col-sm-8">
                                <input id="privacyShortcutInput" asp-for="privacyShortcut">
                                <span asp-validation-for="privacyShortcut" class="text-danger"></span>
                            </div>
                        </div>
                    </li>
                    <li>
                        <div class="row">
                            <label class="col-sm-4 col-form-label">Go to About page: </label>
                            <div class="col-sm-8">
                                <input id="aboutShortcutInput" asp-for="aboutShortcut">
                                <span asp-validation-for="aboutShortcut" class="text-danger"></span>
                            </div>
                        </div>
                    </li>
                    <li>
                        <div class="row">
                            <label class="col-sm-4 col-form-label">Go to Settings page: </label>
                            <div class="col-sm-8">
                                <input id="settingsShortcutInput" asp-for="settingsShortcut">
                                <span asp-validation-for="settingsShortcut" class="text-danger"></span>
                            </div>
                        </div>
                    </li>
                    <li>
                        <div class="row">
                            <label class="col-sm-4 col-form-label">Toggle Dark Mode: </label>
                            <div class="col-sm-8">
                                <input id="darkModeShortcutInput" asp-for="darkModeShortcut">
                                <span asp-validation-for="darkModeShortcut" class="text-danger"></span>
                            </div>
                        </div>
                    </li>
                </ul>
            </ul>
                    
            <ul>
                <li><h5>Used in Books page</h5></li>
                <ul>
                    <li>
                        <div class="row">
                            <label class="col-sm-4 col-form-label">Create New Book: </label>
                            <div class="col-sm-8">
                                <input id="createBookShortcutInput" asp-for="createBookShortcut">
                                <span asp-validation-for="createBookShortcut" class="text-danger"></span>
                            </div>
                        </div>
                    </li>
                    <li>
                        <div class="row">
                            <label class="col-sm-4 col-form-label">Focus on Searchbar: </label>
                            <div class="col-sm-8">
                                <input id="searchbarFocusShortcutInput" asp-for="searchbarFocusShortcut">
                                <span asp-validation-for="searchbarFocusShortcut" class="text-danger"></span>
                            </div>
                        </div>
                    </li>
                    <li>
                        <div class="row">
                            <label class="col-sm-4 col-form-label">Open Genre Filter Dropdown Menu: </label>
                            <div class="col-sm-8">
                                <input id="genreFilterShortcutInput" asp-for="genreFilterShortcut">
                                <span asp-validation-for="genreFilterShortcut" class="text-danger"></span>
                            </div>
                        </div>
                    </li>
                    <li>
                        <div class="row">
                            <label class="col-sm-4 col-form-label">Open Ownership Filter Dropdown Menu: </label>
                            <div class="col-sm-8">
                                <input id="ownershipFilterShortcutInput" asp-for="ownershipFilterShortcut">
                                <span asp-validation-for="ownershipFilterShortcut" class="text-danger"></span>
                            </div>
                        </div>
                    </li>
                    <li>
                        <div class="row">
                            <label class="col-sm-4 col-form-label">Change View </label>
                            <div class="col-sm-8">
                                <input id="changeViewShortcutInput" asp-for="changeViewShortcut">
                                <span asp-validation-for="changeViewShortcut" class="text-danger"></span>
                            </div>
                        </div>
                    </li>
                    <li>Maneuver Upwards in Filter Menus: 'UpArrow'</li>
                    <li>Maneuver Downwards in Filter Menus: 'DownArrow'</li>
                    <li>Go to next Book Page: 'RightArrow'</li>
                    <li>Go to previous Book Page: 'LeftArrow'</li>
                </ul>
            </ul>
            
            
        </li>
    </ul>

    <div class="button-container">
        <button type="submit" class="btn btn-primary">Confirm Changes</button>
        <a class="btn btn-secondary ms-2" asp-area="" asp-controller="Home" asp-action="Index">Exit Page</a>
    </div>
    </form>
</div>

<script>
    const changeUsernameButton = document.getElementById("changeUsername");

    changeUsernameButton.addEventListener("click", () => {
        let newUsername = prompt("What do you want your new Username to be?");
        if (newUsername) {
            document.getElementById("newUserInput").value = newUsername;
            document.getElementById("newUsernameForm").submit();
        }
    })
</script>