@model PasswordResetDto
@{
}

<div class="row">
    <div class="col-md-8 mx-auto rounded border p-3">
        <h2 class="text-center mb-5">Reset your password</h2>

        <form method="post" asp-controller="Account" asp-action="PasswordReset">
            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Password</label>
                <div class="col-sm-8">
                    <input type="password" class="form-control" asp-for="newPassword">
                    <span asp-validation-for="newPassword" class="text-danger"></span>
                </div>
            </div>

            <input type="hidden" asp-for="Email" />

            <div class="row mb-3">
                <label class="col-sm-4 col-form-label">Re-enter password</label>
                <div class="col-sm-8">
                    <input type="password" class="form-control" asp-for="secondAttemptNewPassword">
                    <span asp-validation-for="secondAttemptNewPassword" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="offset-sm-4 col-sm-4 d-grid">
                    <button type="submit" class="btn btn-primary">Set New Password</button>
                </div>
                <div class="col-sm-4 d-grid">
                    <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index" role="button">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>
