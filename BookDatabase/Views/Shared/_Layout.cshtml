

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookDatabase</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookDatabase.styles.css" asp-append-version="true" />
    <style>
        #darkModeToggle {
            border: 1px solid white;
            border-radius: 50%;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BookDatabase</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a id="home-button" class="nav-link text-dark shiny-button" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <a id="books-button" class="nav-link text-dark shiny-button" asp-area="" asp-controller="Books" asp-action="Index">Books</a>
                            }
                            else
                            {
                                <a id="books-button" class="nav-link text-dark shiny-button" asp-area="" asp-controller="Account" asp-action="LogIn">Books</a>
                            }
                        </li>
                        <li class="nav-item">
                            <a id="privacy-button" class="nav-link text-dark shiny-button" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a id="about-button" class="nav-link text-dark shiny-button" asp-area="" asp-controller="Home" asp-action="About">About</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto d-flex align-items-center">
                        <li class="nav-item">
                            <a id="signup-button" class="nav-link text-dark shiny-button" asp-area="" asp-controller="Account" asp-action="SignUp">Sign Up</a>
                        </li>
                        @if (!User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a id="login-button" class="nav-link text-dark shiny-button" asp-area="" asp-controller="Account" asp-action="LogIn">Log In</a>
                            </li>
                        }
                        <li>
                            <div class="position-relative">
                                <img id="accountMenuButton" class="user-menu" src="~/Images/AnonymousProfilePicture-modified.png" width="65px;" style="cursor:pointer;"/>
                                <img id="accountMenuAlternateButton" class="user-menu d-none" src="~/Images/AlternateProfilePicture.png" width="65px;" style="cursor:pointer;" title="Change Profile Picture"/>
                                <img id="darkModeToggle" src="~/Images/DarkModeToggleImg-modified.png" width="65px;" style="cursor:pointer;" title="Dark mode toggle"/>

                                <div id="account-loggedin-dropdown-menu" class="card p-3 d-none position-absolute user-menu" style="top: 100px; right: 0; z-index: 1000; width: 200px;">
                                    <h6 class="mb-2 user-menu">Hello, @User.Identity?.Name</h6>
                                    <ul id="statsDropdown" data-loaded="false" style="padding-left: 0; list-style: none;"></ul>
                                    <div class="d-flex align-items-center gap-2 mb-2 user-menu">
                                        <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="nav-link btn btn-link" style="color: deepskyblue; text-decoration: underline;">Logout</button>
                                        </form>
                                    </div>
                                </div>

                                <div id="account-loggedout-dropdown-menu" class="card p-3 d-none position-absolute user-menu" style="top: 100px; right: 0; z-index: 1000; width: 200px;">

                                    <h6 class="mb-2 user-menu">No account found</h6>
                                    <div class="d-flex align-items-center gap-2 mb-2 user-menu">
                                        <p class="user-menu">Try <a style="color: deepskyblue; text-decoration: underline;" asp-area="" asp-controller="Account" asp-action="LogIn">Logging In</a></p>
                                    </div>
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - BookDatabase - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>

<script>
    //Goals: only when the menu is open and you hover over the pfp icon again does it change to the alternate with a title of "change profile picture"
    //Clicking on it brings the user to a separate page where they can enter an image to be there new pfp
    //Once the new pfp is in place the alternate image should no longer appear
    //a button labeled "remove pfp" should appear and when clicked simply deletes the users custom pfp and returns to the default
    const isAuthenticated = @(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false");


    const accountMenu = document.getElementById("accountMenuButton");
    const alternateAccountMenu = document.getElementById("accountMenuAlternateButton");
    const darkModeButton = document.getElementById("darkModeToggle");
    let isRotated = false
    let menuOpen = false

    const loggedInDropdownMenu = document.getElementById("account-loggedin-dropdown-menu");
    const loggedOutDropdownMenu = document.getElementById("account-loggedout-dropdown-menu");

    const shinyButtons = document.getElementsByClassName("shiny-button");

    window.addEventListener('DOMContentLoaded', () => {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'dark') {
            document.body.classList.add('dark-mode');
        }
    })

    window.addEventListener("keyup", (e) => {
        const tag = document.activeElement.tagName.toLowerCase();
        if (["input", "textarea", "select"].includes(tag)) return;

        if (e.key === 'm') {
            darkModeButtonFunctions();
        }
        if (e.key === 'h' && document.activeElement.id !== "book-searchbar") {
            window.location.href = "/";
        }
        if (e.key === 'b' && document.activeElement.id !== "book-searchbar" && isAuthenticated) {
            window.location.href = "/Books";
        }
        if (e.key === 'b' && document.activeElement.id !== "book-searchbar" && !isAuthenticated) {
            window.location.href = "/Account/Login";
        }
        if (e.key === 'p' && document.activeElement.id !== "book-searchbar") {
            window.location.href = "/Home/Privacy";
        }
        if (e.key === 'a' && document.activeElement.id !== "book-searchbar") {
            window.location.href = "/Home/About";
        }
    });

    document.addEventListener("click", async (e) => {
        if (menuOpen && !e.target.classList.contains("user-menu")) {
            if (isAuthenticated) {
                loggedInDropdownMenu.classList.toggle('d-none');

            } else {
                loggedOutDropdownMenu.classList.toggle('d-none');
            }

            menuOpen = !menuOpen;
        }
    })

    accountMenu.addEventListener("click", async () => {
        if (isAuthenticated) {
            loggedInDropdownMenu.classList.toggle('d-none');
            menuOpen = !loggedInDropdownMenu.classList.contains('d-none');

            if(menuOpen) {
                accountMenu.addEventListener("mouseover", () => {
                    alternateAccountMenu.classList.remove("d-none");
                    accountMenu.classList.add("d-none");
                    alternateAccountMenu.addEventListener("mouseout", () => {
                        accountMenu.classList.remove("d-none");
                        alternateAccountMenu.classList.add("d-none");
                    })
                })
                
            }

            const statsDropdown = document.getElementById("statsDropdown");
            if (statsDropdown && statsDropdown.dataset.loaded === "false") {
                const response = await fetch('/Books/UserStats');
                const html = await response.text();
                statsDropdown.innerHTML = html;
                statsDropdown.dataset.loaded = "true";
            }
        } else {
            loggedOutDropdownMenu.classList.toggle('d-none');
            menuOpen = !loggedOutDropdownMenu.classList.contains('d-none');
        }
    });

    alternateAccountMenu.addEventListener("click", () => {
        window.location.href = '/Account/PfpImgChange'
    })

    darkModeButton.addEventListener("click", darkModeButtonFunctions);

    function darkModeButtonFunctions() {
        isRotated = !isRotated;
        darkModeButton.style.transition = 'transform 0.5s ease-in-out';
        darkModeButton.style.transform = isRotated ? 'rotate(180deg)' : 'rotate(0deg)';

        document.body.classList.toggle('dark-mode');

        if (document.body.classList.contains('dark-mode')) {
            localStorage.setItem('theme', 'dark');
        } else {
            localStorage.setItem('theme', 'light');
        }
    }

    Array.from(shinyButtons).forEach((button) => {
        button.addEventListener("mouseover", () => {
            button.classList.remove("text-dark");
            button.style.color = 'deepskyblue';
            button.style.textDecoration = 'underline';
        })
        button.addEventListener("mouseout", () => {
            button.classList.add("text-dark");
            button.style.textDecoration = '';
        })
    })

</script>