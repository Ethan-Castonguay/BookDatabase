@model TableSorter
@{
}

<head>
    <style>
        #book-searchbar {
            border-radius: 5px;
        }

        #book-table {
            border-collapse: separate;
            border-spacing: 0;
            border: 1px solid #ccc;
            border-radius: 12px;
            overflow: hidden;
        }
    </style>
</head>

<div id="logged-in-table">
    <h1 class="text-center mb-5">List of Books</h1>
    <div class="row mb-5">
        <div class="col">
            <a class="btn btn-primary" asp-controller="Books" asp-action="Create">New Book</a>
            <input id="book-searchbar" type="text" placeholder="search for something..." style="margin-left: 45px;"/>
                <label for="page-size" style="margin-left: 65px;">Books per page</label>
                <select name="page-size" id="page-size">
                    <option value=5>5</option>
                    <option value=10>10</option>
                    <option value=20>20</option>
                </select>
            
        </div>
        <div class="col d-flex align-items-start justify-content-end">
            <div class="position-relative">
                <p id="menu-toggle" class="mb-0" style="font-size: 24px; cursor: pointer;">☰</p>

                <div id="dropdown-menu" class="card p-3 d-none position-absolute" style="top: 30px; right: 0; z-index: 1000; width: 200px;">
                
                        <h6 class="mb-2">Show only:</h6>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <input id="optionOwned" type="radio" name="option" value="Owned" />
                            <label for="optionOwned" class="mb-0">Owned books</label>
                        </div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <input id="optionNotOwned" type="radio" name="option" value="Not-Owned" />
                            <label for="optionNotOwned" class="mb-0">Books to buy</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionUnentered" type="radio" name="option" value="Unentered" />
                            <label for="optionUnentered" class="mb-0">Books w/o status</label>
                        </div>
                </div>
            </div>
        </div>
    </div>

    <form id="sort-form" method="get">
        <input type="hidden" asp-for="books" />
        <input type="hidden" id="selected-input" name="selected" value="@Model.selected" asp-for="selected"/>
        <input type="hidden" id="isDown-input" name="isDown" value="@Model.isDown.ToString().ToLower()" asp-for="isDown"/>
    </form>

    <table id="book-table" class="table rounded d-none">
        
        <thead>
            <tr>
                <th id="table-id" style="cursor: pointer">Id &uarr;</th>
                <th>Status</th>
                <th id="table-title" style="cursor: pointer">Title</th>
                <th id="table-date" style="cursor: pointer">Publication Year</th>
                <th id="table-author" style="cursor: pointer">Author</th>
                <th>Image</th>
                <th>Action</th>
            </tr>
            </thead>
        


        <tbody id="book-table-body">
            @foreach(var book in Model.books)
            {
                var status = book.Status ?? "Unentered";
                var title = book.title ?? "";
                var author = book.author ?? "";
                <tr data-status="@status" data-title="@title" data-author="@author">
                    <td>@book.Id</td>
                    <td>@book.Status</td>
                    <td>@book.title</td>
                    <td>@book.publicationYear</td>
                    <td>@book.author</td>
                    <td><img src="~/Images/@book.ImageFileName" width="100" /></td>
                    <td style="white-space: nowrap">
                        <a class="btn btn-primary btn-sm" asp-controller="Books" asp-action="Edit" asp-route-id="@book.Id">Edit</a>
                        <a class="btn btn-primary btn-sm" asp-controller="Books" asp-action="Delete" 
                            asp-route-id="@book.Id" onclick="return confirm('are you sure?')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
        </table>
        <p id="empty-table-paragraph" style="display: flex; justify-content:center; align-items: center">To add books to your list either click the blue 'create' button or press the 'n' key on your keyboard</p>

    <div id="pagination-buttons"></div>
</div>

<script>
    const wholeTable = document.getElementById("book-table");
    const emptyParagraph = document.getElementById("empty-table-paragraph");

    if(@Model.books.Count > 0) {
        wholeTable.classList.remove("d-none");
        emptyParagraph.classList.add("d-none");
    } else {
        wholeTable.classList.add("d-none");
        emptyParagraph.classList.remove("d-none");
    }
</script>

<script>
    const tableIdButton = document.getElementById("table-id");
    const tableTitleButton = document.getElementById("table-title");
    const tableDateButton = document.getElementById("table-date");
    const tableAuthorButton = document.getElementById("table-author");
    const sortForm = document.getElementById("sort-form");
    const selectedInput = document.getElementById("selected-input");
    const isDownInput = document.getElementById("isDown-input");
    let selected = "@Model.selected";
    let directionDown = "@Model.isDown" === 'true' ? true : false;

    if (selected === "id") {
        tableIdButton.innerHTML = directionDown ? "Id &uarr;" : "Id &darr;";
    } else if (selected === "title") {
        tableTitleButton.innerHTML = !directionDown ? "Title &uarr;" : "Title &darr;";
        tableIdButton.innerHTML = "Id";
    } else if (selected === "author"){
        tableAuthorButton.innerHTML = !directionDown ? "Author &uarr;" : "Author &darr;";
        tableIdButton.innerHTML = "Id";
    } else {
        tableDateButton.innerHTML = !directionDown ? "Publication Year &uarr;" : "Publication Year &darr;";
        tableIdButton.innerHTML = "Id";
    }

    //problems: takes two clicks for the id and only the id, the others work on first click. Arrows don't work whatsoever
    tableIdButton.addEventListener("click", () => {
        if (selected == "id") {
            tableIdButton.innerHTML = directionDown ? "Id &uarr;" : "Id &darr;";
            directionDown = !directionDown;
        } else {
            tableIdButton.innerHTML = "Id &darr;"
            tableTitleButton.innerHTML = "Title";
            tableAuthorButton.innerHTML = "Author";
            directionDown = true;
            selected = "id";
        }

        selectedInput.value = selected;
        isDownInput.value = directionDown.toString();
        sortForm.submit();
    })

    tableTitleButton.addEventListener("click", () => {
        if (selected == "title") {
            tableTitleButton.innerHTML = directionDown ? "Title &uarr;" : "Title &darr;";
            directionDown = !directionDown;
        } else {
            tableIdButton.innerHTML = "Id"
            tableTitleButton.innerHTML = "Title &darr;";
            tableAuthorButton.innerHTML = "Author";
            directionDown = true;
            selected = "title";
        }

        selectedInput.value = selected;
        isDownInput.value = directionDown.toString();
        sortForm.submit();
    })

    tableAuthorButton.addEventListener("click", () => {
        if (selected == "author") {
            tableAuthorButton.innerHTML = directionDown ? "Author &uarr;" : "Author &darr;";
            directionDown = !directionDown;
        } else {
            tableIdButton.innerHTML = "Id"
            tableTitleButton.innerHTML = "Title";
            tableAuthorButton.innerHTML = "Author &darr;";
            directionDown = true;
            selected = "author";
        }

        selectedInput.value = selected;
        isDownInput.value = directionDown.toString();
        sortForm.submit();
    })

    tableDateButton.addEventListener("click", () => {
        if (selected == "date") {
            tableAuthorButton.innerHTML = directionDown ? "Publication Year &uarr;" : "Publication Year &darr;";
            directionDown = !directionDown;
        } else {
            tableIdButton.innerHTML = "Id"
            tableTitleButton.innerHTML = "Title";
            tableAuthorButton.innerHTML = "Author &darr;";
            tableDateButton.innerHTML = "Publication Year &darr;";
            directionDown = true;
            selected = "date";
        }

        selectedInput.value = selected;
        isDownInput.value = directionDown.toString();
        sortForm.submit();
    })
</script>

<script>

    const tableBody = document.getElementById("book-table-body");
    const allRows = Array.from(tableBody.querySelectorAll("tr"));
    
    const searchbar = document.getElementById("book-searchbar");
    const paginationContainer = document.getElementById("pagination-buttons")
    const pageSizeWheel = document.getElementById("page-size");
    const hamburgerMenu = document.getElementById("menu-toggle");
    const dropdownMenu = document.getElementById("dropdown-menu");

    let rowsPerPage = 5;
    let filterRestrictedRows = [...allRows];
    let filteredRows = [...allRows];
    let currentPage = 1;
    let isBurgerRotated = false;
    let selectedRadio = null;

    //Keyboard shortcuts
    document.addEventListener("keyup", (e) => {
        if (e.key === 'n' && document.activeElement.id !== "book-searchbar") {
            window.location.href = "/Books/Create";
        }
        if (e.key === '/' && document.activeElement.id === "book-searchbar") {
            searchbar.blur();
            searchbar.value = "";
            filterRows();
        }
        else if (e.key === '/' && document.activeElement.id !== "book-searchbar") {
            searchbar.focus();
            if (!dropdownMenu.classList.contains("d-none")) {
                dropdownMenu.classList.add("d-none");
                    isBurgerRotated = !isBurgerRotated;
                    hamburgerMenu.style.transition = 'transform 0.25s ease-in-out';
                    hamburgerMenu.style.transform = isBurgerRotated ? 'rotate(90deg)' : 'rotate(0deg)';
            }
            
        }
        if (e.key === 'ArrowRight' && currentPage !== paginationContainer.children.length) {
            currentPage += 1;
            updateTableDisplay();
        } 
        if (e.key === 'ArrowLeft' && currentPage !== 1) {
            currentPage -= 1;
            updateTableDisplay();
        }
    })

    //Hamburger menu
    hamburgerMenu.addEventListener("click", () => {
        dropdownMenu.classList.toggle('d-none');
        isBurgerRotated = !isBurgerRotated;
        hamburgerMenu.style.transition = 'transform 0.25s ease-in-out';
        hamburgerMenu.style.transform = isBurgerRotated ? 'rotate(90deg)' : 'rotate(0deg)';
    })

    searchbar.addEventListener("click", () => {
        if (!dropdownMenu.classList.contains("d-none")) {
            dropdownMenu.classList.add("d-none");
            isBurgerRotated = !isBurgerRotated;
            hamburgerMenu.style.transition = 'transform 0.25s ease-in-out';
            hamburgerMenu.style.transform = isBurgerRotated ? 'rotate(90deg)' : 'rotate(0deg)';
        }
    })

    pageSizeWheel.addEventListener("click", () => {
        if (!dropdownMenu.classList.contains("d-none")) {
            dropdownMenu.classList.add("d-none");
            isBurgerRotated = !isBurgerRotated;
            hamburgerMenu.style.transition = 'transform 0.25s ease-in-out';
            hamburgerMenu.style.transform = isBurgerRotated ? 'rotate(90deg)' : 'rotate(0deg)';
        }
    })

    //dropdown menu
    document.querySelectorAll('input[type="radio"][name="option"]').forEach(radio => {
        radio.addEventListener('click', function () {

            if (selectedRadio === this) {
                this.checked = false;
                selectedRadio = null;

                filterRestrictedRows = allRows;
                filterRows();
                updateTableDisplay();
                return;
            }
            selectedRadio = this;

            const selectedValue = this.value;

            filterRestrictedRows = allRows.filter(row => {
                return row.dataset.status === selectedValue;
            });
            filterRows();
            updateTableDisplay();
        });
    });

    //searchbar
    pageSizeWheel.addEventListener("input", () => {
        if (pageSizeWheel.value != rowsPerPage) {
            rowsPerPage = pageSizeWheel.value;
            updateTableDisplay();
        }
    })

    function updateTableDisplay() {
        const start = (currentPage - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        allRows.forEach(row => row.classList.add("d-none"));
        filteredRows.slice(start, end).forEach(row => row.classList.remove("d-none"));

        renderPaginationButtons();
    }

    function renderPaginationButtons() {
        const pageCount = Math.ceil(filteredRows.length / rowsPerPage);
        paginationContainer.innerHTML = "";
        if (pageCount > 1){
            for (let i = 1; i <= pageCount; i++) {
                const button = document.createElement("button");
                button.className = "btn btn-outline-primary mx-1";
                if (i === currentPage) button.classList.add("active");
                button.innerText = i;
                button.addEventListener("click", () => {
                    currentPage = i;
                    updateTableDisplay();
                });
                paginationContainer.appendChild(button);
            }
        }
    }

    function filterRows() {
        const term = searchbar.value.toLowerCase();

        filteredRows = allRows.filter(row => {
            const title = row.dataset.title.toLowerCase() || "";
            const author = row.dataset.author.toLowerCase() || "";
            return (title.includes(term) || author.includes(term)) && filterRestrictedRows.includes(row);
        });

        currentPage = 1;
        updateTableDisplay();
    }

    // Initial setup
    searchbar.addEventListener("input", filterRows);
    filterRows(); // Load first page on startup
</script>