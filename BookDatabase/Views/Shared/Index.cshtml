@model TableSorter
@{
}

<head>
    <style>
        #book-searchbar {
            border-radius: 5px;
        }

        #book-table {
            border-collapse: separate;
            border-spacing: 0;
            border: 1px solid #ccc;
            border-radius: 12px;
            overflow: hidden;
        }
    </style>
</head>

<div id="logged-in-table">
    <h1 class="text-center mb-5">List of Books</h1>
    <div class="row mb-5">
        <div class="col">
            <a class="btn btn-primary" asp-controller="Books" asp-action="Create">New Book</a>
            <input id="book-searchbar" type="text" placeholder="search for something..." style="margin-left: 55px;"/>
                <label for="page-size" style="margin-left: 55px;">Books per page</label>
                <select name="page-size" id="page-size">
                    <option value=5>5</option>
                    <option value=10>10</option>
                    <option value=20>20</option>
                </select>
            
        </div>
        <div class="col d-flex align-items-start justify-content-end">
            

            <p class="mb-0" style="font-size: 24px;">🏷️ [</p>
            <div class="position-relative">
               
                <p id="genre-menu-toggle" class="mb-0" style="font-size: 24px; cursor: pointer;">≡</p>
                
                <div id="genre-dropdown-menu" class="card p-3 position-absolute d-none" style="top: 30px; right: 0; z-index: 1000; width: 200px;">
                
                        <h6 class="mb-2">Show only (Genre):</h6>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionFantasy" type="radio" name="genreOption" value="Fantasy" />
                            <label for="optionFantasy" class="mb-0">Fantasy</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionSciFi" type="radio" name="genreOption" value="Sci-Fi" />
                            <label for="optionSciFi" class="mb-0">Science Fiction</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionMystery" type="radio" name="genreOption" value="Mystery" />
                            <label for="optionMystery" class="mb-0">Mystery</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionThriller" type="radio" name="genreOption" value="Thriller" />
                            <label for="optionThriller" class="mb-0">Thriller</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionRomance" type="radio" name="genreOption" value="Romance" />
                            <label for="optionRomance" class="mb-0">Romance</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionHorror" type="radio" name="genreOption" value="Horror" />
                            <label for="optionHorror" class="mb-0">Horror</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionHistFi" type="radio" name="genreOption" value="Hist-Fi" />
                            <label foroptionHistFi class="mb-0">Historical Fiction</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionContempFi" type="radio" name="genreOption" value="Contemp-Fi" />
                            <label for="optionContempFi" class="mb-0">Contemp. Fiction</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionBiography" type="radio" name="genreOption" value="Biography" />
                            <label for="optionBiography" class="mb-0">Biography</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionSelfHelp" type="radio" name="genreOption" value="Self-Help" />
                            <label for="optionSelfHelp" class="mb-0">Self-Help</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionScience" type="radio" name="genreOption" value="Science" />
                            <label for="optionScience" class="mb-0">Science</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionHistory" type="radio" name="genreOption" value="History" />
                            <label for="optionHistory" class="mb-0">History</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionYA" type="radio" name="genreOption" value="YA" />
                            <label for="optionYA" class="mb-0">Young Adult</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionChildren" type="radio" name="genreOption" value="Children" />
                            <label for="optionChildren" class="mb-0">Children's</label>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <input id="optionOther" type="radio" name="genreOption" value="Other" />
                            <label for="optionOther" class="mb-0">Other</label>
                        </div>
                </div>
            </div>
            <p class="mb-0" style="font-size: 24px;">]</p>

            <p class="mb-0" style="font-size: 24px;">📦 [</p>
            <div class="position-relative">

                <p id="ownership-menu-toggle" class="mb-0" style="font-size: 24px; cursor: pointer;">≡</p>

                <div id="dropdown-menu" class="card p-3 d-none position-absolute" style="top: 30px; right: 0; z-index: 1000; width: 200px;">

                    <h6 class="mb-2">Show only (ownership):</h6>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <input id="optionOwned" type="radio" name="ownershipOption" value="Owned" />
                        <label for="optionOwned" class="mb-0">Owned books</label>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <input id="optionNotOwned" type="radio" name="ownershipOption" value="Not-Owned" />
                        <label for="optionNotOwned" class="mb-0">Books to buy</label>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <input id="optionUnentered" type="radio" name="ownershipOption" value="Unentered" />
                        <label for="optionUnentered" class="mb-0">Books w/o status</label>
                    </div>
                </div>
            </div>
            <p class="mb-0" style="font-size: 24px; margin-right: 20px;">]</p>
        </div>
    </div>

    <form id="sort-form" method="get">
        <input type="hidden" asp-for="books" />
        <input type="hidden" id="selected-input" name="selected" value="@Model.selected" asp-for="selected"/>
        <input type="hidden" id="isDown-input" name="isDown" value="@Model.isDown.ToString().ToLower()" asp-for="isDown"/>
    </form>

    <table id="book-table" class="table rounded d-none">
        
        <thead>
            <tr>
                <th id="table-id" style="cursor: pointer">Id &uarr;</th>
                <th>Status</th>
                <th id="table-title" style="cursor: pointer">Title</th>
                <th id="table-date" style="cursor: pointer">Publication Year</th>
                <th id="table-author" style="cursor: pointer">Author</th>
                <th>Image</th>
                <th>Action</th>
            </tr>
            </thead>
        


        <tbody id="book-table-body">
            @foreach(var book in Model.books)
            {
                var status = book.Status ?? "Unentered";
                var title = book.title ?? "";
                var author = book.author ?? "";
                var genre = book.genre ?? "";
                <tr data-status="@status" data-title="@title" data-author="@author" data-genre="@genre">
                    <td>@book.Id</td>
                    <td>@book.Status</td>
                    <td>@book.title</td>
                    <td>@book.publicationYear</td>
                    <td>@book.author</td>
                    <td><img src="~/Images/@book.ImageFileName" width="100" /></td>
                    <td style="white-space: nowrap">
                        <a class="btn btn-primary btn-sm" asp-controller="Books" asp-action="Edit" asp-route-id="@book.Id">Edit</a>
                        <a class="btn btn-primary btn-sm" asp-controller="Books" asp-action="Delete" 
                            asp-route-id="@book.Id" onclick="return confirm('are you sure?')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
        </table>
        <p id="empty-table-paragraph" style="display: flex; justify-content:center; align-items: center">To add books to your list either click the blue 'create' button or press the 'n' key on your keyboard</p>

    <div id="pagination-buttons"></div>
</div>

<script>
    const wholeTable = document.getElementById("book-table");
    const emptyParagraph = document.getElementById("empty-table-paragraph");

    if(@Model.books.Count > 0) {
        wholeTable.classList.remove("d-none");
        emptyParagraph.classList.add("d-none");
    } else {
        wholeTable.classList.add("d-none");
        emptyParagraph.classList.remove("d-none");
    }
</script>

<script>
    const tableIdButton = document.getElementById("table-id");
    const tableTitleButton = document.getElementById("table-title");
    const tableDateButton = document.getElementById("table-date");
    const tableAuthorButton = document.getElementById("table-author");
    const sortForm = document.getElementById("sort-form");
    const selectedInput = document.getElementById("selected-input");
    const isDownInput = document.getElementById("isDown-input");
    let selected = "@Model.selected";
    let directionDown = "@Model.isDown" === 'true' ? true : false;

    if (selected === "id") {
        tableIdButton.innerHTML = directionDown ? "Id &uarr;" : "Id &darr;";
    } else if (selected === "title") {
        tableTitleButton.innerHTML = !directionDown ? "Title &uarr;" : "Title &darr;";
        tableIdButton.innerHTML = "Id";
    } else if (selected === "author"){
        tableAuthorButton.innerHTML = !directionDown ? "Author &uarr;" : "Author &darr;";
        tableIdButton.innerHTML = "Id";
    } else {
        tableDateButton.innerHTML = !directionDown ? "Publication Year &uarr;" : "Publication Year &darr;";
        tableIdButton.innerHTML = "Id";
    }

    tableIdButton.addEventListener("click", () => {
        if (selected == "id") {
            tableIdButton.innerHTML = directionDown ? "Id &uarr;" : "Id &darr;";
            directionDown = !directionDown;
        } else {
            tableIdButton.innerHTML = "Id &darr;"
            tableTitleButton.innerHTML = "Title";
            tableAuthorButton.innerHTML = "Author";
            directionDown = true;
            selected = "id";
        }

        selectedInput.value = selected;
        isDownInput.value = directionDown.toString();
        sortForm.submit();
    })

    tableTitleButton.addEventListener("click", () => {
        if (selected == "title") {
            tableTitleButton.innerHTML = directionDown ? "Title &uarr;" : "Title &darr;";
            directionDown = !directionDown;
        } else {
            tableIdButton.innerHTML = "Id"
            tableTitleButton.innerHTML = "Title &darr;";
            tableAuthorButton.innerHTML = "Author";
            directionDown = true;
            selected = "title";
        }

        selectedInput.value = selected;
        isDownInput.value = directionDown.toString();
        sortForm.submit();
    })

    tableAuthorButton.addEventListener("click", () => {
        if (selected == "author") {
            tableAuthorButton.innerHTML = directionDown ? "Author &uarr;" : "Author &darr;";
            directionDown = !directionDown;
        } else {
            tableIdButton.innerHTML = "Id"
            tableTitleButton.innerHTML = "Title";
            tableAuthorButton.innerHTML = "Author &darr;";
            directionDown = true;
            selected = "author";
        }

        selectedInput.value = selected;
        isDownInput.value = directionDown.toString();
        sortForm.submit();
    })

    tableDateButton.addEventListener("click", () => {
        if (selected == "date") {
            tableAuthorButton.innerHTML = directionDown ? "Publication Year &uarr;" : "Publication Year &darr;";
            directionDown = !directionDown;
        } else {
            tableIdButton.innerHTML = "Id"
            tableTitleButton.innerHTML = "Title";
            tableAuthorButton.innerHTML = "Author &darr;";
            tableDateButton.innerHTML = "Publication Year &darr;";
            directionDown = true;
            selected = "date";
        }

        selectedInput.value = selected;
        isDownInput.value = directionDown.toString();
        sortForm.submit();
    })
</script>

<script>

    const tableBody = document.getElementById("book-table-body");
    const allRows = Array.from(tableBody.querySelectorAll("tr"));
    
    const searchbar = document.getElementById("book-searchbar");
    const paginationContainer = document.getElementById("pagination-buttons")
    const pageSizeWheel = document.getElementById("page-size");
    const genreHamburgerMenu = document.getElementById("genre-menu-toggle");
    const ownershipHamburgerMenu = document.getElementById("ownership-menu-toggle");
    const genreDropdownMenu = document.getElementById("genre-dropdown-menu");
    const ownershipDropdownMenu = document.getElementById("dropdown-menu");

    let rowsPerPage = 5;
    let filterGenreRestrictedRows = [...allRows];
    let filterOwnershipRestrictedRows = [...allRows];
    let filteredRows = [...allRows];
    let currentPage = 1;
    let isGenreBurgerRotated = false;
    let isOwnershipBurgerRotated = false;
    let selectedRadio = null;

    //Keyboard shortcuts
    document.addEventListener("keyup", (e) => {
        if (e.key === 'n' && document.activeElement.id !== "book-searchbar") {
            window.location.href = "/Books/Create";
        }

        if (e.key === '/' && document.activeElement.id === "book-searchbar") {
            searchbar.blur();
            searchbar.value = "";
            filterRows();
        }
        else if (e.key === '/' && document.activeElement.id !== "book-searchbar") {
            searchbar.focus();
            if (!ownershipDropdownMenu.classList.contains("d-none")) {
                ownershipDropdownMenu.classList.add("d-none");
                    isOwnershipBurgerRotated = !isOwnershipBurgerRotated;
                    ownershipHamburgerMenu.style.transition = 'transform 0.25s ease-in-out';
                    ownershipHamburgerMenu.style.transform = isOwnershipBurgerRotated ? 'rotate(90deg)' : 'rotate(0deg)';
            }

            if (!genreDropdownMenu.classList.contains("d-none")) {
                genreDropdownMenu.classList.add("d-none");
                isGenreBurgerRotated = !isGenreBurgerRotated;
                genreHamburgerMenu.style.transition = 'transform 0.25s ease-in-out';
                genreHamburgerMenu.style.transform = isGenreBurgerRotated ? 'rotate(90deg)' : 'rotate(0deg)';
            }
        }
        
        //This is next: when the hamburger menus are open you can use the arrows to change the filter to the immediate next category
        if (e.key === 'ArrowUp' && (!genreDropdownMenu.classList.contains("d-none") || !ownershipDropdownMenu.classList.contains("d-none"))){

        }
        if (e.key === 'ArrowDown' && (!genreDropdownMenu.classList.contains("d-none") || !ownershipDropdownMenu.classList.contains("d-none"))){

        }
        if (e.key === 'ArrowRight' && currentPage !== paginationContainer.children.length) {
            currentPage += 1;
            updateTableDisplay();
        } 
        if (e.key === 'ArrowLeft' && currentPage !== 1) {
            currentPage -= 1;
            updateTableDisplay();
        }

        if(e.key === 'i' && document.activeElement.id !== "book-searchbar") {
            openGenreHamburger();
        }
        if(e.key === 'o' && document.activeElement.id !== "book-searchbar") {
            openOwnershipHamburger();
        }
    })

    //Hamburger menu
    genreHamburgerMenu.addEventListener("click", openGenreHamburger);
    ownershipHamburgerMenu.addEventListener("click", openOwnershipHamburger);
    

    searchbar.addEventListener("click", () => {
        if (!ownershipDropdownMenu.classList.contains("d-none")) {
            ownershipDropdownMenu.classList.add("d-none");
            isOwnershipBurgerRotated = !isOwnershipBurgerRotated;
            ownershipHamburgerMenu.style.transition = 'transform 0.25s ease-in-out';
            ownershipHamburgerMenu.style.transform = isOwnershipBurgerRotated ? 'rotate(90deg)' : 'rotate(0deg)';
        }
        if (!genreDropdownMenu.classList.contains("d-none")) {
            genreDropdownMenu.classList.add("d-none");
            isGenreBurgerRotated = !isGenreBurgerRotated;
            genreHamburgerMenu.style.transition = 'transform 0.25s ease-in-out';
            genreHamburgerMenu.style.transform = isGenreBurgerRotated ? 'rotate(90deg)' : 'rotate(0deg)';
        }
    })

    pageSizeWheel.addEventListener("click", () => {
        if (!ownershipDropdownMenu.classList.contains("d-none")) {
            ownershipDropdownMenu.classList.add("d-none");
            isOwnershipBurgerRotated = !isOwnershipBurgerRotated;
            ownershipHamburgerMenu.style.transition = 'transform 0.25s ease-in-out';
            ownershipHamburgerMenu.style.transform = isOwnershipBurgerRotated ? 'rotate(90deg)' : 'rotate(0deg)';
        }
        if (!genreDropdownMenu.classList.contains("d-none")) {
            genreDropdownMenu.classList.add("d-none");
            isGenreBurgerRotated = !isGenreBurgerRotated;
            genreHamburgerMenu.style.transition = 'transform 0.25s ease-in-out';
            genreHamburgerMenu.style.transform = isGenreBurgerRotated ? 'rotate(90deg)' : 'rotate(0deg)';
        }
    })

    //dropdown ownership menu
    document.querySelectorAll('input[type="radio"][name="ownershipOption"]').forEach(radio => {
        radio.addEventListener('click', function () {

            if (selectedRadio === this) {
                this.checked = false;
                selectedRadio = null;

                filterOwnershipRestrictedRows = allRows;
                filterRows();
                updateTableDisplay();
                return;
            }
            selectedRadio = this;

            const selectedValue = this.value;

            filterOwnershipRestrictedRows = allRows.filter(row => {
                return row.dataset.status === selectedValue;
            });
            filterRows();
            updateTableDisplay();
        });
    });

    //dropdown genre menu
    document.querySelectorAll('input[type="radio"][name="genreOption"]').forEach(radio => {
        radio.addEventListener('click', function () {

            if (selectedRadio === this) {
                this.checked = false;
                selectedRadio = null;

                filterGenreRestrictedRows = allRows;
                filterRows();
                updateTableDisplay();
                return;
            }
            selectedRadio = this;

            const selectedValue = this.value;

            filterGenreRestrictedRows = allRows.filter(row => {
                return row.dataset.genre === selectedValue;
            });
            filterRows();
            updateTableDisplay();
        });
    });

    //searchbar
    pageSizeWheel.addEventListener("input", () => {
        if (pageSizeWheel.value != rowsPerPage) {
            rowsPerPage = pageSizeWheel.value;
            updateTableDisplay();
        }
    })

    function updateTableDisplay() {
        const start = (currentPage - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        allRows.forEach(row => row.classList.add("d-none"));
        filteredRows.slice(start, end).forEach(row => row.classList.remove("d-none"));

        renderPaginationButtons();
    }

    function renderPaginationButtons() {
        const pageCount = Math.ceil(filteredRows.length / rowsPerPage);
        paginationContainer.innerHTML = "";
        if (pageCount > 1){
            for (let i = 1; i <= pageCount; i++) {
                const button = document.createElement("button");
                button.className = "btn btn-outline-primary mx-1";
                if (i === currentPage) button.classList.add("active");
                button.innerText = i;
                button.addEventListener("click", () => {
                    currentPage = i;
                    updateTableDisplay();
                });
                paginationContainer.appendChild(button);
            }
        }
    }

    function filterRows() {
        const term = searchbar.value.toLowerCase();

        filteredRows = allRows.filter(row => {
            const title = row.dataset.title.toLowerCase() || "";
            const author = row.dataset.author.toLowerCase() || "";
            return (title.includes(term) || author.includes(term)) && filterOwnershipRestrictedRows.includes(row) && filterGenreRestrictedRows.includes(row) ;
        });

        currentPage = 1;
        updateTableDisplay();
    }

    function openGenreHamburger() {
        if (!ownershipDropdownMenu.classList.contains("d-none")) {
            ownershipDropdownMenu.classList.add("d-none");
            isOwnershipBurgerRotated = !isOwnershipBurgerRotated;
            ownershipHamburgerMenu.style.transition = 'transform 0.25s ease-in-out';
            ownershipHamburgerMenu.style.transform = isOwnershipBurgerRotated ? 'rotate(90deg)' : 'rotate(0deg)';
        }

        genreDropdownMenu.classList.toggle('d-none');
        isGenreBurgerRotated = !isGenreBurgerRotated;
        genreHamburgerMenu.style.transition = 'transform 0.25s ease-in-out';
        genreHamburgerMenu.style.transform = isGenreBurgerRotated ? 'rotate(90deg)' : 'rotate(0deg)';
    }

    function openOwnershipHamburger() {
        if (!genreDropdownMenu.classList.contains("d-none")) {
            genreDropdownMenu.classList.add("d-none");
            isGenreBurgerRotated = !isGenreBurgerRotated;
            genreHamburgerMenu.style.transition = 'transform 0.25s ease-in-out';
            genreHamburgerMenu.style.transform = isGenreBurgerRotated ? 'rotate(90deg)' : 'rotate(0deg)';
        }

        ownershipDropdownMenu.classList.toggle('d-none');
        isOwnershipBurgerRotated = !isOwnershipBurgerRotated;
        ownershipHamburgerMenu.style.transition = 'transform 0.25s ease-in-out';
        ownershipHamburgerMenu.style.transform = isOwnershipBurgerRotated ? 'rotate(90deg)' : 'rotate(0deg)';
    }


    // Initial setup
    searchbar.addEventListener("input", filterRows);
    filterRows(); // Load first page on startup
</script>